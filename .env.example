APP_ORIGIN=http://localhost:3100
MONGODB_URI=mongodb://127.0.0.1:27028/?replicaSet=astra&directConnection=true
MONGODB_DATABASE=astra_comics
STORAGE_DRIVER=local
LOCAL_R2_URL=http://127.0.0.1:8788
# Generate local secrets and .env.local with npm run local:init.
LOCAL_R2_TOKEN=
RATE_LIMIT_SECRET=
# Explicit seed credentials; seed refuses production and never resets existing users.
SEED_PASSWORD=
# Only for STORAGE_DRIVER=r2; keep the bucket private.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Enable only behind a trusted proxy that overwrites the selected header.
TRUST_PROXY=false
TRUSTED_IP_HEADER=cf-connecting-ip

# Separate app origins; set HTTPS hosts for production.
READER_ORIGIN=http://localhost:3100
STUDIO_ORIGIN=http://localhost:3101
ADMIN_ORIGIN=http://localhost:3102
