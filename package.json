{
  "name": "astra-comics",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/service.mjs reader dev",
    "build": "node scripts/service.mjs reader build",
    "start": "node scripts/service.mjs reader start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/studio && tsc --noEmit -p apps/admin",
    "lint": "eslint src apps/*/src scripts/*.ts tests/unit tests/integration tests/e2e playwright.config.ts next.shared.mjs",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --env-file=.env.local --test tests/integration/*.test.ts",
    "db:up": "docker compose -f compose.local.yml up -d --wait",
    "db:down": "docker compose -f compose.local.yml down",
    "db:indexes": "tsx --env-file=.env.local scripts/indexes.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "storage:dev": "node --env-file=.env.local scripts/local/r2.mjs",
    "local:init": "node scripts/local/init.mjs",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "format": "prettier --write src apps/*/src scripts/**/*.ts tests/**/*.ts next.config.mjs next.shared.mjs playwright.config.ts",
    "dev:studio": "node scripts/service.mjs studio dev",
    "dev:admin": "node scripts/service.mjs admin dev",
    "build:studio": "node scripts/service.mjs studio build",
    "build:admin": "node scripts/service.mjs admin build",
    "build:all": "npm run build && npm run build:studio && npm run build:admin",
    "start:studio": "node scripts/service.mjs studio start",
    "start:admin": "node scripts/service.mjs admin start",
    "test:services": "node --env-file=.env.local tests/service-isolation.mjs",
    "db:accounts": "tsx --env-file=.env.local scripts/seed.ts --accounts-only",
    "test:onboarding": "node --env-file=.env.local tests/author-onboarding.mjs",
    "db:admin": "tsx --env-file=.env.local scripts/local-admin.ts",
    "test:studio": "node --env-file=.env.local tests/studio-publishing.mjs",
    "db:chapters": "tsx --env-file=.env.local scripts/chapters-backfill.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "lucide-react": "^1.49.0",
    "mongodb": "^7.7.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "sharp": "$sharp",
    "undici": "^7.29.1"
  }
}
