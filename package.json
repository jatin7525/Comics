{
  "name": "astra-comics",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts/*.ts tests/unit tests/integration tests/e2e playwright.config.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --env-file=.env.local --test tests/integration/*.test.ts",
    "db:up": "docker compose -f compose.local.yml up -d --wait",
    "db:down": "docker compose -f compose.local.yml down",
    "db:indexes": "tsx --env-file=.env.local scripts/indexes.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "storage:dev": "node --env-file=.env.local scripts/local/r2.mjs",
    "local:init": "node scripts/local/init.mjs",
    "test:e2e": "node --env-file=.env.local node_modules/@playwright/test/cli.js test",
    "format": "prettier --write src scripts/**/*.ts tests/**/*.ts next.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "lucide-react": "^1.49.0",
    "mongodb": "^7.7.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "sharp": "$sharp",
    "undici": "^7.29.1"
  }
}
